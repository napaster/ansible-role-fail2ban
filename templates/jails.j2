{{ 'ignoreself = ' + j['ignoreself'] }}
{% endif %}
{% if j['ignoreip'] is defined and j['ignoreip'] != '' %}
{% if j['ignoreip'] is string %}
{{ 'ignoreip = ' + j['ignoreip'] | ansible.utils.ipaddr() }}
{% elif j['ignoreip'] is sequence %}
{% for ji in j['ignoreip'] %}
{% if loop['first'] %}
{{ 'ignoreip =' -}}
{% endif %}
{% if ji | ansible.utils.ipaddr() %}
{{ ' ' + ji -}}
{% endif %}
{% if loop['last'] %}
{{ '' }}
{% endif %}
{% endfor %}
{% endif %}
{% endif %}
