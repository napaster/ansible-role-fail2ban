{% endif %}
{% if j['banaction'] is defined and j['banaction'] != '' %}
{{ 'banaction = ' + j['banaction'] }}
{% endif %}
{% if j['banaction_allports'] is defined and j['banaction_allports'] != '' %}
{{ 'banaction_allports = ' + j['banaction_allports'] }}
{% endif %}
{% if j['action'] is defined and j['action'] != '' %}
{% if j['action_options'] is defined and j['action_options'] != '' %}
{% for ja in j['action_options'] %}
{% for k,v in ja.items() %}
{% if loop['first'] %}
{{ 'action = ' + j['action'] + '[' -}}
{% endif %}
{{ k + '=\"' ~ v ~ '\"' -}}
{% if loop['last'] %}
{{ ']' }}
{% else %}
{{ "," -}}
{% endif %}
{% endfor %}
{% endfor %}
{% else %}
{{ 'action = ' + j['action'] }}
{% endif %}
{% endif %}
